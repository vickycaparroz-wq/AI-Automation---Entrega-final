    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Obtener el string enviado por el agente\nconst rawOutput = $json.output || \"\";\n\ntry {\n  // Limpiar marcas de bloques de código markdown si existieran\n  let cleanText = rawOutput.replace(/```json/gi, '').replace(/```/g, '').trim();\n\n  // Extraer el contenido encerrado en llaves {}\n  const jsonMatch = cleanText.match(/\\{[\\s\\S]*\\}/);\n  if (!jsonMatch) {\n    throw new Error(\"No se encontró estructura JSON.\");\n  }\n\n  let jsonString = jsonMatch[0];\n\n  // Reparar errores comunes de sintaxis generados por LLMs (como falta de comas entre clave-valor)\n  jsonString = jsonString.replace(/(\":\\s*\"[^\"]*\")\\s*\\n?\\s*(\")/g, '$1,\\n$2');\n\n  // Parsear el objeto JSON corregido\n  const parsed = JSON.parse(jsonString);\n\n  return {\n    prioridad: parsed.prioridad || \"Media\",\n    categoria: parsed.categoria || \"Acceso\",\n    respuesta_sugerida: parsed.respuesta_sugerida || rawOutput\n  };\n\n} catch (e) {\n  // En caso de fallo irrecuperable, entrega una estructura segura sin detener el flujo\n  return {\n    prioridad: \"Media\",\n    categoria: \"Acceso\",\n    respuesta_sugerida: rawOutput,\n    error_parseo: e.message\n  };\n}"
      },
